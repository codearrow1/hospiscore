# ---------------------------------------------------------------------------
# HospiScore — data source configuration
# Copy this file to `.env.local` and fill in values. The app runs in "demo"
# mode (seeded properties, no network) until GOOGLE_PLACES_API_KEY is set.
# ---------------------------------------------------------------------------

# --- Google Places API (property search + Google review signals) ---
# Required to switch to live data mode.
# Get a key: https://console.cloud.google.com/apis/credentials
# Enable:  "Places API (New)"  and  "Maps JavaScript API"
GOOGLE_PLACES_API_KEY=

# --- Client-side Places Autocomplete (optional, recommended) ---
# A separate key, restricted to YOUR app origin (NOT the server key above),
# used by the browser for the autocomplete dropdown. Requires the
# "Maps JavaScript API" to be enabled. If empty, search falls back to the
# text-based box.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Review-data provider (OTA reviews) ---
# "demo"  = enrich from the seeded dataset (default, works offline).
# "stayapi" or "apify" = live OTA review data.
REVIEW_PROVIDER=demo

# For "stayapi": base URL such as https://api.stayapi.example.com
REVIEW_BASE_URL=
# API key for the review provider (StayAPI key or Apify Read API token).
REVIEW_API_KEY=

# --- Caching (optional) ---
# "memory" (default, zero config) or "redis" (requires `npm i redis` + REDIS_URL).
CACHE_PROVIDER=memory
REDIS_URL=
# Set CACHE_DISABLED=1 to bypass the cache entirely (debugging).
CACHE_DISABLED=0

# --- Score history (snapshot worker) ---
# Where file-based score snapshots are stored (default: <project>/var/scores).
# Run `npm run snapshot` on a schedule to build trend data.
SCORE_HISTORY_DIR=

# --- DeepSeek (AI reply drafts) ---
# Used to draft professional responses to (negative) guest reviews on the
# property page. If empty, the app falls back to a deterministic template
# so the feature still works offline.
# Get a key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# Model + endpoint (defaults are fine).
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Owner accounts (auth + saved properties) ---
# JSON file backing users/sessions/saved properties (default <project>/var/data.json).
# Override only if you keep the data file elsewhere. Sessions are httpOnly cookies.
APP_DATA_FILE=
# Session cookie name + lifetime (days).
APP_SESSION_COOKIE=hs_session
APP_SESSION_DAYS=30

# --- Data persistence backend ---
# "file" (default, JSON document in APP_DATA_FILE) or "sqlite" (Node 22.5+/24,
# uses SQLITE_FILE). Both implement the same interface in lib/db.ts.
DATA_PROVIDER=file
SQLITE_FILE=
# Secondary copy of the data document, kept in sync on every write and used to
# recover when the primary file is lost/reset (e.g. deploys that replace the
# app directory). Defaults to <home>/.hospiscore/data.json, which survives
# app-directory deploys. Set APP_DATA_MIRROR= (empty) to disable.
APP_DATA_MIRROR=

# --- Payment provider secrets at rest ---
# Gateway API keys / webhook secrets are stored ENCRYPTED (AES-256-GCM). Set an
# opaque value here for high-assurance deployments, e.g. the output of:
#   openssl rand -hex 64
# If unset, a deterministic PBKDF2 demo key is derived from APP_DATA_MIRROR
# (demo/self-hosted only — not suitable for production).
PAYMENT_ENC_KEY=

# --- Apify review-text ingest ---
# Dataset ID of a scheduled Apify actor (e.g. Google Maps / Booking review actor)
# plus the Apify API token in REVIEW_API_KEY (see review provider section above).
APIFY_DATASET_ID=
APIFY_BASE_URL=https://api.apify.com

# --- Weekly score-alert e-mail ---
# Optional endpoint that receives the alert digest as JSON ({to,subject,html}),
# e.g. a Resend/Mailgun endpoint or a dev relay. If empty, `npm run alerts`
# prints the digest to stdout instead of sending.
ALERT_WEBHOOK_URL=

# --- Internal admin access (sales leads) ---
# Comma-separated e-mail addresses allowed to open /account/leads, which lists
# demo bookings and score-report captures. Empty = nobody (lead capture still
# works; the admin view is simply closed).
ADMIN_EMAILS=

# --- Marketing command center demo accounts ---
# The 6 demo team accounts (superadmin/marketing/salesmanager/sales/content/
# analyst @hospios.demo) are seeded automatically in non-production only.
# To also seed them in production (demo site), set:
# ALLOW_DEMO_SEED=1
# They are re-created idempotently (missing accounts only) and are full product
# accounts with marketing roles; keep this OFF unless you run a demo install.
ALLOW_DEMO_SEED=0

# ---------------------------------------------------------------------------
# SaaS Business Control Plane (Prisma + SQLite)
# ---------------------------------------------------------------------------

# SaaS commerce database. PRODUCTION: keep the file inside var/ so it is
# excluded from deploys (see .gitignore /var/) but include the directory in
# your backup routine. NOTE: if the deploy path contains spaces, use an
# absolute path without spaces instead.
DATABASE_URL="file:./var/saas.db"

# Shared secret for cron endpoints. Required in production so only the
# scheduler can trigger them:
#   POST /api/saas/cron/dunning      (daily — processes due payment retries)
#   POST /api/saas/cron/automation   (daily — lifecycle emails + health rules)
# Call with header: X-Cron-Secret: <value>
CRON_SECRET=

# Public site URL used to build affiliate referral links.
SITE_URL=https://thebuddharice.online